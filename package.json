{
  "name": "nuxt-boilerplate",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "eslint:check": "eslint .",
    "eslint:fix": "eslint . --fix",
    "prettier:check": "prettier --check .",
    "prettier:fix": "prettier --write .",
    "typecheck": "nuxt typecheck",
    "fix": "pnpm run prettier:fix && pnpm run eslint:fix",
    "check": "pnpm run fix && pnpm run prettier:check && pnpm run eslint:check && pnpm run typecheck && pnpm run test --run",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest --project unit",
    "test:nuxt": "vitest --project nuxt",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky",
    "sync-boilerplate": "tsx sync-boilerplate.ts"
  },
  "dependencies": {
    "@pinia/colada": "^1.4.9",
    "@unhead/vue": "^3.4.3",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "pinia-orm": "^2.0.0",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@iconify-json/flag": "^1.2.15",
    "@iconify-json/fluent": "^1.2.61",
    "@iconify-json/ph": "^1.2.2",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/fonts": "1.2.0",
    "@nuxt/hints": "1.1.5",
    "@nuxt/icon": "2.6.2",
    "@nuxt/image": "2.2.1",
    "@nuxt/scripts": "1.3.12",
    "@nuxt/test-utils": "4.4.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@pinia/colada-nuxt": "1.2.1",
    "@pinia/nuxt": "1.0.3",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/nuxt": "^15.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-oxlint": "^1.93.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "oxlint": "^1.93.0",
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "sass": "^1.108.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14",
    "zod": "^4.6.7"
  }
}
